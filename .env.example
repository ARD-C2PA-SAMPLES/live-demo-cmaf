# Template for .env, which docker compose reads automatically.
# Copy it and fill in your license key:
#
#   cp .env.example .env
#
# .env is git ignored on purpose - the license key does not belong in the
# repository.

# Unified Streaming license key, required by the origin. Contact
# sales@unified-streaming.com for one. Without it the live-origin container
# exits with "Error: UspLicenseKey environment variable is required but not
# set." and rtmp-ingest never starts, because it waits for a healthy origin.
UspLicenseKey=

# Prefix for the container names, defaults to the directory name.
COMPOSE_PROJECT_NAME=live-demo-cmaf

# Host port for the HTTPS entry point (docker compose --profile tls up -d),
# needed to open the player on anything but localhost - see the README. Set
# it to 443 for URLs without a port number.
TLS_PORT=8443

# Host port for the bit flipping proxy (same tls profile). It serves the same
# player and the same stream as TLS_PORT, but flips bits in CMAF media
# segments, so C2PA validation fails on the segments it touched:
#   https://<host>:8444/          player on the damaged stream
#   https://<host>:8444/glitch/   control panel
GLITCH_PORT=8444

# Defaults for the corruption, all of them changeable at runtime from
# https://<host>:8444/glitch/ - no restart needed.
GLITCH_ENABLED=true
# corrupt every Nth media segment, counted per representation (0 = never)
GLITCH_EVERY=5
# bit flips per corrupted segment: 1 breaks the C2PA hash but usually not the
# picture, a few thousand break the picture as well
GLITCH_BITS=1
# which box to hit:
#   mdat  media payload - breaks the segment hash
#   c2pa  the inband COSE_Sign1 signature - breaks validation
#   moof  fragment header - breaks the decoder
#   any   anywhere
GLITCH_TARGET=mdat
# regex on the segment name, empty means every track, e.g. video or audio_eng
GLITCH_TRACKS=

# Basic auth for the control panel at https://<host>:8444/glitch/. It guards
# the switches only - the stream, the player and /glitch/healthz stay open, so
# playback and the container healthcheck need no credentials. Leave the
# password empty to turn the prompt off.
GLITCH_USER=glitch
GLITCH_PASSWORD=glitch
