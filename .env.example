# Template for .env, which docker compose reads automatically.
# Copy it and fill in your license key:
#
#   cp .env.example .env
#
# .env is git ignored on purpose - the license key does not belong in the
# repository.

# Unified Streaming license key, required by the origin. Contact
# sales@unified-streaming.com for one. Without it the live-origin container
# exits with "Error: UspLicenseKey environment variable is required but not
# set." and rtmp-ingest never starts, because it waits for a healthy origin.
UspLicenseKey=

# Prefix for the container names, defaults to the directory name.
COMPOSE_PROJECT_NAME=live-demo-cmaf

# Host port for the HTTPS entry point (docker compose --profile tls up -d),
# needed to open the player on anything but localhost - see the README. Set
# it to 443 for URLs without a port number.
TLS_PORT=8443
